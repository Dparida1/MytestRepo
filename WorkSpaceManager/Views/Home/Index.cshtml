@model WorkSpaceManager.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col">
        <h1 class="h3 mb-0">
            <i class="fas fa-tachometer-alt me-2"></i>Dashboard
        </h1>
        <p class="text-muted">AWS WorkSpaces Overview</p>
    </div>
    <div class="col-auto">
        <button type="button" class="btn btn-outline-primary btn-sm" onclick="location.reload()">
            <i class="fas fa-sync me-1"></i>Refresh
        </button>
    </div>
</div>

<!-- Key Metrics -->
<div class="row mb-4">
    <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title mb-0">Total WorkSpaces</h6>
                        <h3 class="mb-0">@Model.TotalWorkSpaces</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-desktop fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title mb-0">Running</h6>
                        <h3 class="mb-0">@Model.RunningWorkSpaces</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-play-circle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title mb-0">Stopped</h6>
                        <h3 class="mb-0">@Model.StoppedWorkSpaces</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-stop-circle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title mb-0">Pending Requests</h6>
                        <h3 class="mb-0">@Model.PendingRequests</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-clock fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title mb-0">Completed Today</h6>
                        <h3 class="mb-0">@Model.CompletedRequestsToday</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-check-circle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
        <div class="card bg-danger text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title mb-0">Failed Today</h6>
                        <h3 class="mb-0">@Model.FailedCreationsToday</h3>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-exclamation-circle fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row mb-4">
    <div class="col-lg-4 mb-3">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fas fa-chart-pie me-2"></i>WorkSpaces by Region
                </h6>
            </div>
            <div class="card-body">
                <canvas id="regionChart" height="200"></canvas>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4 mb-3">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fas fa-chart-pie me-2"></i>WorkSpaces by State
                </h6>
            </div>
            <div class="card-body">
                <canvas id="stateChart" height="200"></canvas>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4 mb-3">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fas fa-chart-pie me-2"></i>WorkSpaces by Bundle
                </h6>
            </div>
            <div class="card-body">
                <canvas id="bundleChart" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity and Quick Actions -->
<div class="row">
    <div class="col-lg-8 mb-3">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0">
                    <i class="fas fa-history me-2"></i>Recent Activity
                </h6>
                <small class="text-muted">Last 10 activities</small>
            </div>
            <div class="card-body">
                @if (Model.RecentActivity.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var activity in Model.RecentActivity)
                        {
                            <div class="list-group-item border-0 px-0">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center mb-1">
                                            <i class="fas fa-@(activity.Type == "WorkSpace" ? "desktop" : "file-alt") me-2 text-muted"></i>
                                            <span class="fw-medium">@activity.Activity</span>
                                        </div>
                                        <small class="text-muted">by @activity.User</small>
                                    </div>
                                    <small class="text-muted">@activity.Timestamp.ToString("MMM dd, HH:mm")</small>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fas fa-inbox fa-3x mb-3"></i>
                        <p class="mb-0">No recent activity</p>
                    </div>
                }
            </div>
        </div>
    </div>
    
    <div class="col-lg-4 mb-3">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fas fa-bolt me-2"></i>Quick Actions
                </h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="@Url.Action("Create", "WorkSpace")" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Create WorkSpaces
                    </a>
                    <a href="@Url.Action("Index", "WorkSpace")" class="btn btn-outline-primary">
                        <i class="fas fa-list me-2"></i>View All WorkSpaces
                    </a>
                    <a href="@Url.Action("Index", "Reports")" class="btn btn-outline-secondary">
                        <i class="fas fa-chart-bar me-2"></i>View Reports
                    </a>
                    <hr>
                    <button type="button" class="btn btn-outline-info" onclick="syncData()">
                        <i class="fas fa-sync me-2"></i>Sync from AWS
                    </button>
                </div>
            </div>
        </div>
        
        <!-- System Status -->
        <div class="card mt-3">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fas fa-server me-2"></i>System Status
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-6">
                        <div class="text-center">
                            <div class="text-success">
                                <i class="fas fa-database fa-2x"></i>
                            </div>
                            <small class="text-muted">Database</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="text-center">
                            <div class="text-success">
                                <i class="fas fa-cloud fa-2x"></i>
                            </div>
                            <small class="text-muted">AWS API</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        // Initialize charts
        initializeCharts();
    });

    function initializeCharts() {
        // Region Chart
        $.get('@Url.Action("GetDashboardChartData", "Home")', { chartType: 'region' })
            .done(function(data) {
                createPieChart('regionChart', data.labels, data.data, 'WorkSpaces by Region');
            });

        // State Chart
        $.get('@Url.Action("GetDashboardChartData", "Home")', { chartType: 'state' })
            .done(function(data) {
                createPieChart('stateChart', data.labels, data.data, 'WorkSpaces by State');
            });

        // Bundle Chart
        $.get('@Url.Action("GetDashboardChartData", "Home")', { chartType: 'bundle' })
            .done(function(data) {
                createPieChart('bundleChart', data.labels, data.data, 'WorkSpaces by Bundle');
            });
    }

    function createPieChart(canvasId, labels, data, title) {
        const ctx = document.getElementById(canvasId).getContext('2d');
        
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: [
                        '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF',
                        '#FF9F40', '#FF6384', '#C9CBCF', '#4BC0C0', '#36A2EB'
                    ],
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 10,
                            usePointStyle: true
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((context.parsed / total) * 100).toFixed(1);
                                return `${context.label}: ${context.parsed} (${percentage}%)`;
                            }
                        }
                    }
                }
            }
        });
    }
</script>
}

<style>
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: 1px solid rgba(0, 0, 0, 0.125);
    }
    
    .card-header {
        background-color: #f8f9fa;
        border-bottom: 1px solid rgba(0, 0, 0, 0.125);
    }
    
    .list-group-item:hover {
        background-color: #f8f9fa;
    }
    
    .opacity-75 {
        opacity: 0.75;
    }
</style>